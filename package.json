{
  "name": "@aranlucas/oxlint-plugin-anti-slop",
  "version": "0.1.1",
  "description": "Opinionated Oxlint rules that reject low-evidence TypeScript and JavaScript patterns. Packaged fork of dmmulroy/anti-slop.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "lint",
    "oxlint",
    "oxlint-plugin"
  ],
  "homepage": "https://github.com/aranlucas/oxlint-plugin-anti-slop#readme",
  "bugs": "https://github.com/aranlucas/oxlint-plugin-anti-slop/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aranlucas/oxlint-plugin-anti-slop.git"
  },
  "files": [
    "dist",
    "UPSTREAM.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/vendor/eslint-stylistic/padding-line-options.d.ts src/vendor/eslint-stylistic/LICENSE src/vendor/eslint-stylistic/UPSTREAM.md dist/vendor/eslint-stylistic/",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:dist",
    "lint": "oxlint src test",
    "test": "vitest run",
    "test:dist": "node test/dist.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm check",
    "prepare": "husky",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.89.0"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "0.2.2",
    "@types/node": "26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "oxlint": ">=1.78.0"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.14.0"
}
