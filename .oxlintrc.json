{
  "options": {
    "typeAware": true
  },
  "extends": ["./node_modules/@aranlucas/oxforge/configs/recommended.json"],
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "src/vendor/eslint-stylistic/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "overrides": [
    {
      "files": [
        "src/rules/no-runtime-typeof.ts",
        "src/rules/require-safety-comment-for-type-assertion.ts",
        "src/shared/array-method.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    }
  ]
}
